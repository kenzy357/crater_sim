        </dynamics>
      </axis>
    </joint>
    <link name='fr_wheel_link'>
      <pose relative_to='wheeljoint_frontright'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.107</mass>
        <inertia>
          <ixx>0.01299</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00731</iyy>
          <iyz>0</iyz>
          <izz>0.00731</izz>
        </inertia>
      </inertial>
      <collision name='fr_wheel_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.162</radius>
            <length>0.120</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
