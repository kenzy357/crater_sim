      <visual name='fr_wheel_visual'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.162</radius>
            <length>0.120</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

