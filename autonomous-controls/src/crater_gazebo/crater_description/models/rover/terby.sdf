<?xml version="1.0"?>
<sdf version='1.8'>
  <model name='terby'>

    <!-- ================================================================
         CORRECTED DIMENSIONS:
           X = forward/backward = wheelbase   = 1.135 m
           Y = left/right       = track width = 0.614 m

         Wheel positions in base_link frame:
           FL: x=+0.5675  y=+0.307  z=-0.31
           FR: x=+0.5675  y=-0.307  z=-0.31
           RL: x=-0.5675  y=+0.307  z=-0.31
           RR: x=-0.5675  y=-0.307  z=-0.31

         Chassis: 1.135 x 0.614 x 0.10 m  (length x width x height)
         Front bumper: box at x=+0.5875 (past front wheel line)
    ================================================================ -->

    <!-- CHASSIS -->
    <link name='base_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.784</mass>
        <inertia>
          <ixx>0.00212</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00115</iyy>
          <iyz>0</iyz>
          <izz>0.00149</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <geometry>
          <box>
            <size>1.135 0.614 0.10</size>
          </box>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction>
            <ode><mu>0.05</mu><mu2>0.05</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <geometry>
          <box>
            <size>1.135 0.614 0.10</size>
          </box>
        </geometry>
      </visual>
      <!-- Front bumper: marks +X (forward) direction -->
      <visual name='front_bumper_visual'>
        <pose>0.5875 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.614 0.08</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- ================================================================
         FRONT LEFT
    ================================================================ -->
    <joint name='steeringjoint_frontleft' type='revolute'>
      <pose relative_to='base_link'>0.5675 0.307 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>fl_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.1</lower>
          <upper>2.1</upper>
          <effort>50</effort>
          <velocity>6.28</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='fl_steering_link'>
      <pose relative_to='steeringjoint_frontleft'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.155 0 0 0</pose>
        <mass>0.306</mass>
        <inertia>
          <ixx>0.00037</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00022</iyy>
          <iyz>0</iyz>
          <izz>0.00046</izz>
        </inertia>
      </inertial>
      <collision name='fl_steering_collision'>
        <pose>0 0 -0.155 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.31</length>
          </cylinder>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
        </surface>
      </collision>
      <visual name='fl_steering_visual'>
        <pose>0 0 -0.155 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.31</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name='wheeljoint_frontleft' type='revolute'>
      <pose relative_to='fl_steering_link'>0 0 -0.31 0 0 0</pose>
      <parent>fl_steering_link</parent>
      <child>fl_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>15</effort>
          <velocity>20</velocity>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='fl_wheel_link'>
      <pose relative_to='wheeljoint_frontleft'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.107</mass>
        <inertia>
          <ixx>0.01299</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00731</iyy>
          <iyz>0</iyz>
          <izz>0.00731</izz>
        </inertia>
      </inertial>
      <collision name='fl_wheel_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.162</radius>
            <length>0.120</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode/></contact>
        </surface>
      </collision>
      <visual name='fl_wheel_visual'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.162</radius>
            <length>0.120</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

