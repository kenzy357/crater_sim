        <joint name="rocker_pivot_left" type="revolute">
            <parent>chassis</parent>
            <child>rocker_left</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.57</lower>
                    <upper>1.57</upper>
                </limit>
            </axis>
        </joint>

        <joint name="rocker_pivot_right" type="revolute">
            <parent>chassis</parent>
            <child>rocker_right</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.57</lower>
                    <upper>1.57</upper>
                </limit>
            </axis>
        </joint>

        <joint name="steeringjoint_frontleft" type="revolute">
            <parent>rocker_left</parent>
            <child>steering_frontleft</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-6.28</lower>
                    <upper>6.28</upper>
                </limit>
            </axis>
        </joint>

        <joint name="steeringjoint_backleft" type="revolute">
